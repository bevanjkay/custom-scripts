{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["**/*.ts", "**/*.json", "!**/node_modules", "!**/dist"]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "assist": {
    "actions": {
